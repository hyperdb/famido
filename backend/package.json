{
  "name": "timeline-todo-backend",
  "version": "1.0.0",
  "description": "Cloudflare Workers + Hono + D1 API for Timeline Todo",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "d1:init": "wrangler d1 execute timeline-todo-db --local --file=./src/db/schema.sql",
    "d1:seed": "wrangler d1 execute timeline-todo-db --local --file=./src/db/seed.sql"
  },
  "dependencies": {
    "hono": "^4.7.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250224.0",
    "typescript": "^5.7.0",
    "wrangler": "^3.111.0"
  }
}
